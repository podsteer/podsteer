# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out

# Go workspace file
go.work
go.work.sum

# Compiled desktop application
/build/bin/

# Badge intermediates. Only the rewritten README.md is committed.
/build/badges/

# Frontend bundle. Generated by `npm --prefix web run build` (or `wails build`)
# and embedded into the binary at compile time. The directory itself is kept so
# that a plain `go build` on a fresh clone still satisfies the //go:embed in
# app/adapters/assets.
/app/adapters/assets/dist/*
!/app/adapters/assets/dist/.gitkeep

# Node
/web/node_modules/

# Wails hashes package.json to decide whether to re-run `npm install`, and
# writes the digest beside it on every `wails dev`/`wails build`. It is a local
# build cache, not a lockfile — committing it would just churn.
/web/package.json.md5

# IDE-specific files
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db

# Log files
*.log
