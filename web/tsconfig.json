{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$stores/*": ["./src/stores/*"],
      "$pages/*": ["./src/pages/*"],
      "$bindings/*": ["./src/lib/bindings/github.com/podsteer/podsteer/app/adapters/wails/*"]
    },
    "types": ["svelte", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.svelte"],
  // `*.node.test.ts` reads the source tree with node's own fs — a test ABOUT
  // the components rather than one of them. It belongs to the node project
  // below, which has those types; the application project must keep them out,
  // or application code could reach for fs and still type-check.
  "exclude": ["src/**/*.node.test.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
